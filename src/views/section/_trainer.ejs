<section class="trainer">
  <svg class="section-border-top"  viewBox="0 0 1440 96" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1440 64L1360 69.3C1280 75 1120 85 960 74.7C800 64 640 32 480 16C320 0 160 0 80 0H0V96H80C160 96 320 96 480 96C640 96 800 96 960 96C1120 96 1280 96 1360 96H1440V64Z" fill="#EB51C2"/>
  </svg>
   <div class="bg">
    <div class="container">
      <h3 class="section-title">Our Trainer</h3>
      <span class="section-subtitle jpText">トレーナー</span>
      <!-- tabbtn -->
      <div class="tabBody">
          <div class="tabWrap" role="tablist">
              <button 
              type="button" 
              role="tab" 
              class="tabBtn jpText"
              aria-controls="trainer"
              aria-selected="true">
                  トレーナー
              </button>
              <button 
              type="button" 
              role="tab" 
              class="tabBtn"
              aria-controls="staff"
              aria-selected="false">
                  スタッフ
              </button>
          </div>
      </div>
      <div class="trainer__body fadein">
          <!-- trainer -->
         <div id="trainer"  class="trainer__wrapper trainer-aria is-active">
          <% trainerData.forEach(item=>{ %>
           <div class="trainer__content">
             <figure class="trainer__image">
               <img width="360" height="350" src="../img/<%= item.image %>" alt="<%= item.alt %>">
             </figure>
             <div class="trainer__textBody">
               <p class="trainer__text">
                  <%= item.text %>
               </p>
             </div>
           </div>
         <%  }) %>
         </div>
          <!-- staff -->
          <div id="staff"  class="trainer__wrapper staff-aria">
          <%  staffData.forEach(item=>{ %>
           <div class="trainer__content">
             <figure class="trainer__image">
               <img width="360" height="350" src="../img/<%= item.image %>" alt="<%= item.alt %>">
             </figure>
             <div class="trainer__textBody jpText">
               <p class="trainer__text">
                  <%= item.text %>
               </p>
             </div>
           </div>
         <%  }) %>
          </div>
      </div>
  </div>
   </div>
    <svg class="section-border-bottom"  viewBox="0 0 1440 96" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 32.0001L80 26.7001C160 21.0001 320 11.0001 480 21.3C640 32.0001 800 64.0001 960 80.0001C1120 96.0001 1280 96.0001 1360 96.0001H1440V6.10352e-05H1360C1280 6.10352e-05 1120 6.10352e-05 960 6.10352e-05C800 6.10352e-05 640 6.10352e-05 480 6.10352e-05C320 6.10352e-05 160 6.10352e-05 80 6.10352e-05H0V32.0001Z" fill="#EB51C2"/>
    </svg>
</section>
    